# Caddyfile — VELOS Trade Platform + Notifications gateway
# ----------------------------------------------------------------------------
# This file is OPTIONAL — the default deploy target is Render.com (see
# `render.yaml`), which doesn't need Caddy because Render's own router
# handles TLS + port forwarding.
#
# Use this Caddyfile when self-hosting (Docker Compose, bare metal, VPS)
# so a single TLS cert terminates both the Next.js app and the WebSocket
# notifications gateway on the same origin (avoids CORS friction for the
# browser's WS upgrade handshake).
#
# Topology:
#
#   ┌─────────┐   https://aspidus.example.com   ┌─────────┐
#   │ Browser │ ───────────────────────────────▶│  Caddy  │
#   └─────────┘                                 └────┬────┘
#                                                    │
#              ┌─────────────────────────────────────┼──────────────────────────┐
#              │                                     │                          │
#              ▼                                     ▼                          ▼
#      localhost:3000                       localhost:3001              (static files)
#      Next.js app                          notifications-service       (optional CDN)
#
# Routes:
#   • /socket.io/*             → notifications-service:3001 (WS upgrade)
#   • ?XTransformPort=3001     → notifications-service:3001 (alt WS path
#                                the frontend uses by default — see
#                                `src/hooks/use-realtime.ts`)
#   • everything else          → nextjs:3000 (App Router)
#
# The XTransformPort query param is the frontend's default (so the SPA can
# connect to its own origin with `?XTransformPort=3001`). The /socket.io/*
# path match is a fallback for socket.io's long-poll transport (kept for
# browsers that can't do WS — currently disabled in the gateway's
# `transports: ["websocket"]` config but matched here for forward-compat).

{
	# Global options — adjust to taste.
	email ops@example.com
	# staging {
	#	ca https://acme-staging-v02.api.letsencrypt.org/directory
	# }
}

aspidus.example.com {
	encode zstd gzip

	# ── WebSocket: /socket.io/* ───────────────────────────────────────────
	# Caddy auto-detects the Upgrade: websocket header and proxies the
	# connection as a raw TCP tunnel — no special directive needed beyond
	# `reverse_proxy`. The `flush_interval -1` disables Caddy's write
	# buffering for this route so WS frames aren't delayed.
	@ws path /socket.io/*
	reverse_proxy @ws localhost:3001 {
		# Critical for WebSocket — Caddy must NOT buffer frames.
		flush_interval -1
		# Pass the upstream's Connection + Upgrade headers through unchanged.
		header_up Connection {>http.connection}
		header_up Upgrade {>http.upgrade}
	}

	# ── WebSocket: ?XTransformPort=3001 (frontend default) ───────────────
	# The SPA's `useRealtime` hook connects to `${origin}/?XTransformPort=3001`
	# in production (see `src/hooks/use-realtime.ts`). This route catches
	# that query and proxies to the notifications service. The named matcher
	# `xform_port` is keyed on the query string.
	@xform_port query XTransformPort=3001
	reverse_proxy @xform_port localhost:3001 {
		flush_interval -1
		header_up Connection {>http.connection}
		header_up Upgrade {>http.upgrade}
	}

	# ── Notifications service: internal /emit + /health ──────────────────
	# These endpoints are called by the Next.js API routes via
	# `NOTIFICATIONS_SERVICE_URL=http://localhost:3001` (service-to-service,
	# never hits Caddy). Listed here only so a curiosity-driven browser hit
	# gets routed correctly.
	@notif_internal path /emit /health
	reverse_proxy @notif_internal localhost:3001

	# ── Next.js App Router (default) ─────────────────────────────────────
	# Everything else goes to the Next.js standalone server (production
	# build output: `.next/standalone/server.js`).
	reverse_proxy localhost:3000

	# Static asset caching — Next.js serves these from /_next/static/* with
	# content-hashed filenames, so they're safe to cache aggressively.
	@static path /_next/static/* /favicon.ico /logo.svg /apple-touch-icon.svg
	header @static Cache-Control "public, max-age=31536000, immutable"
}
