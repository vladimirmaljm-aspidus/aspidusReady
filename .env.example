# ── Supabase (production backend) ────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # SERVER ONLY — nikad na frontend
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=<your-jwt-secret>   # Project Settings → API → JWT Secret

# ── App secrets ───────────────────────────────────────────────────────────────
SECRET_KEY=<random 32+ char string>

# ── Initial admin (used by POST /api/setup once) ─────────────────────────────
# Replace with your own secure credentials before first deploy.
ADMIN_USERNAME=<your-admin-username>
ADMIN_PASSWORD=<your-secure-password>
ADMIN_EMAIL=<your-admin-email@example.com>

# ── Public URL of the deployed app ───────────────────────────────────────────
APP_BASE_URL=https://your-app.onrender.com

# ── Backend selector ─────────────────────────────────────────────────────────
# supabase = production (default)
# mock     = in-memory, no seed data (testing only)
# prisma   = legacy SQLite (deprecated)
DB_BACKEND=supabase

# ── Optional: Prisma/SQLite (only used when DB_BACKEND=prisma) ────────────────
# DATABASE_URL="file:./dev.db"
